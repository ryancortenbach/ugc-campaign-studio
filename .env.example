PORT=3000
# Optional. Without these the app uses the explicitly labeled guided intake.
OPENAI_API_KEY=
OPENAI_MODEL=
# Required to enable paid model requests. Set the same secret in the browser's AI settings.
CAMPAIGN_ACCESS_TOKEN=

EXA_API_KEY=
WHOP_COURSE_CHECKOUT_URL=

# Optional. Set true to disable the free, quota-limited Exa MCP route.
EXA_FREE_MCP_DISABLED=false

# Optional read-only Whop offer verification. This does not enable checkout.
WHOP_API_KEY=
WHOP_COURSE_VARIANT_ID=
WHOP_COURSE_PRODUCT_ID=
WHOP_ACCOUNT_ID=
